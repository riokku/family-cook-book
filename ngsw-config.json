{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "recipes",
      "urls": [
        "https://cfdohsyuemvqcnkjfrfk.supabase.co/rest/v1/recipes**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 50,
        "maxAge": "7d",
        "timeout": "3s"
      }
    },
    {
      "name": "recipe-images",
      "urls": [
        "https://cfdohsyuemvqcnkjfrfk.supabase.co/storage/v1/object/public/**",
        "https://cfdohsyuemvqcnkjfrfk.supabase.co/storage/v1/render/image/public/**"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 120,
        "maxAge": "30d"
      }
    }
  ]
}
